          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_leads",
        "title": "List leads",
        "description": "List recent leads (newest first), optionally filtered by lead status or business. Returns name, phone, email, service requested, status and created date.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "business_id": {
              "type": "string",
              "format": "uuid",
              "description": "Limit to one business (see list_businesses)."
            },
            "lead_status": {
              "type": "string",
              "description": "Filter by lead status, e.g. new, contacted, quoted, won, lost."
            },
            "limit": {
              "type": "integer",
              "description": "Max leads to return, 1-100. Default 20."
            }
