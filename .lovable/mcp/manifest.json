              "description": "Target business id.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "inquiry_phone": {
              "description": "Contact phone number.",
              "type": "string"
            },
            "inquiry_email": {
              "description": "Contact email address.",
              "type": "string"
            },
            "requested_service": {
              "description": "Service the lead asked about.",
              "type": "string"
            },
            "message": {
              "description": "Notes or the customer's message.",
              "type": "string"
            },
            "lead_source": {
              "description": "Where the lead came from. Defaults to 'mcp'.",
              "type": "string"
