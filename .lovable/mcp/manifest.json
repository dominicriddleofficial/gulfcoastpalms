          "type": "object",
          "properties": {
            "business_id": {
              "description": "Limit to one business (see list_businesses).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "lead_status": {
              "description": "Filter by lead status, e.g. new, contacted, quoted, won, lost.",
              "type": "string"
            },
            "limit": {
              "description": "Max leads to return, 1-100. Default 20.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
