          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_lead",
        "title": "Create lead",
        "description": "Create a new lead for a business. Provide business_id from list_businesses; if omitted and the user can access exactly one business, that one is used.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "inquiry_name": {
              "type": "string",
              "minLength": 1,
              "description": "Contact name."
            },
            "business_id": {
              "type": "string",
              "format": "uuid",
              "description": "Target business id."
            },
            "inquiry_phone": {
              "type": "string",
              "description": "Contact phone number."
            },
            "inquiry_email": {
              "type": "string",
              "description": "Contact email address."
            },
            "requested_service": {
              "type": "string",
              "description": "Service the lead asked about."
            },
            "message": {
              "type": "string",
              "description": "Notes or the customer's message."
            },
            "lead_source": {
              "type": "string",
              "description": "Where the lead came from. Defaults to 'mcp'."
            }
          },
          "required": [
            "inquiry_name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_customers",
        "title": "Search customers",
        "description": "Search customers by name, company, phone or email. Returns contact details plus yearly-trimming and check-preference flags.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Name, company, phone or email fragment to search for."
            },
            "business_id": {
              "type": "string",
              "format": "uuid",
              "description": "Limit to one business (see list_businesses)."
            },
            "limit": {
              "type": "integer",
              "description": "Max customers to return, 1-50. Default 15."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
